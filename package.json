{
  "name": "haze",
  "version": "1.0.0",
  "description": "haze - black & white Scramjet web proxy",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:infisical": "infisical run --env=dev -- node server.js",
    "build:worker": "esbuild worker.js --bundle --format=esm --platform=neutral --external:cloudflare:sockets --outfile=worker.bundle.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mercuryworkshop/scramjet",
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "dependencies": {
    "@freebuff/auth": "0.1.0",
    "express": "^4.21.2",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
