# haze environment variables
#
# Preferred: store these in Infisical (project "haze") and run the app with
#   infisical run --env=dev -- node server.js
#
# For local-only development you can copy this file to .env — but .env is
# gitignored and must never be committed. Never paste real values anywhere else.

PORT=8000
HOST=0.0.0.0

# HMAC key for chat session tokens (random 64-hex string). If unset, a random
# per-process value is used and existing chat sessions are invalidated on restart.
CHAT_SECRET=

# Archil disk (persistent, shared filesystem for agent/sandbox workloads).
# Create an API key at https://console.archil.com/ then store the real value in
# Infisical (project "haze") or a local .env — never commit it.
# Regions supporting serverless exec: aws-us-east-1, aws-us-west-2, aws-eu-west-1.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
